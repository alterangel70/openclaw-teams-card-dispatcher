# App
APP_NAME=teams-card-dispatcher
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/teams_dispatcher

# Worker
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_BATCH_SIZE=50
MAX_RETRIES=3

# Azure Teams Bot (active dispatch delivery)
BOT_APP_ID=your-bot-app-id
BOT_APP_PASSWORD=your-bot-app-password
BOT_TENANT_ID=your-tenant-id
BOT_NAME=OpenClaw Bot
TEAMS_SERVICE_URL=https://smba.trafficmanager.net/amer

# Seq (optional)
SEQ_URL=
SEQ_API_KEY=
