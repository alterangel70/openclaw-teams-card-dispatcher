# App
APP_NAME=teams-card-dispatcher
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/teams_dispatcher

# Worker
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_BATCH_SIZE=50
MAX_RETRIES=3

# Microsoft Graph (app-only auth)
GRAPH_TENANT_ID=your-tenant-id
GRAPH_CLIENT_ID=your-client-id
GRAPH_CLIENT_SECRET=your-client-secret
GRAPH_SCOPE=https://graph.microsoft.com/.default
GRAPH_TIMEOUT_SECONDS=20

# Seq (optional)
SEQ_URL=
SEQ_API_KEY=
